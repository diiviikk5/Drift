{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Drift desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "dialog:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "shell:default",
    "process:default",
    "updater:default",
    "process:allow-restart"
  ]
}
